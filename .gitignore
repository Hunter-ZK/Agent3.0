# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Python package/build artifacts
*.egg-info/
build/
dist/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE / OS
.DS_Store
.idea/
.vscode/

